{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SGOS",
  "version": "1.3.1",
  "identifier": "com.sgos.personal",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SGOS",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "connect-src 'self' ipc: http://ipc.localhost blob: data: https://api.aladhan.com https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.groq.com https://generativelanguage.googleapis.com",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SGOS",
    "shortDescription": "My Personal Operating System",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
